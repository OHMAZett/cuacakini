/*
  # 1. Content Security Policy (CSP) - Memblokir skrip luar tidak dikenal, inline injection, dan eksfiltrasi data
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://cdnjs.cloudflare.com; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://air-quality-api.open-meteo.com https://api.bigdatacloud.net; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests;

  # 2. Anti-Clickjacking Protection
  X-Frame-Options: DENY

  # 3. Anti-MIME Type Sniffing (Mencegah browser mengeksekusi file berbahaya yang menyamar)
  X-Content-Type-Options: nosniff

  # 4. Strict Referrer Policy (Melindungi privasi URL pengguna)
  Referrer-Policy: strict-origin-when-cross-origin

  # 5. Permissions Policy (Mematikan akses hardware sensitif seperti kamera, mikrofon, dan sensor)
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), display-capture=()

  # 6. HTTP Strict Transport Security (HSTS) - Memaksa koneksi HTTPS aman
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # 7. Cross-Origin Protection
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

